%% language={[Bluespec]Verilog} is how this package was used before v2.0.
\lstalias[Bluespec]{Verilog}[]{BSV}

%% Colors only: the document keeps its own basicstyle, column model and frame.
%% \bfseries needs a typewriter font that has a bold shape, which Computer
%% Modern does not; color carries the distinction on its own.
\lstdefinestyle{bsv}{
  language = BSV,
  keywordstyle = [1]\color{bsvkeyword}\bfseries,
  keywordstyle = [2]\color{bsvtype},
  keywordstyle = [3]\color{bsvfunction},
  keywordstyle = [4]\color{bsvsystemtask},
  keywordstyle = [5]\color{bsvdirective},
  commentstyle = \color{bsvcomment}\itshape,
  stringstyle = \color{bsvstring},
  moredelim = [s][\bsvattributestyle]{(*}{*)},
  showstringspaces = false,
}

\ifbsv@setdefault
  \lstset{style=bsv}
\fi

\endinput
