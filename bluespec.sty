%% \providecolor leaves a color the document defined first alone.  Directives
%% and attributes share a value because both address the toolchain rather than
%% the hardware, but they stay separately redefinable.
\providecolor{bsvkeyword}{HTML}{0F5FA6}
\providecolor{bsvtype}{HTML}{00786B}
\providecolor{bsvfunction}{HTML}{6B3FA0}
\providecolor{bsvsystemtask}{HTML}{2E7D32}
\providecolor{bsvdirective}{HTML}{8A6D00}
\providecolor{bsvattribute}{HTML}{8A6D00}
\providecolor{bsvcomment}{HTML}{707070}
\providecolor{bsvstring}{HTML}{A31515}

%% Attributes are highlighted as a whole, (* and *) included.  The bsv style
%% installs the delimiter; redefine this to change or drop the highlighting.
\newcommand\bsvattributestyle{\color{bsvattribute}}

